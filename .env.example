# Copy to .env and fill in what you need; docker compose reads it. Everything is optional.

# Host port for the board.
# KANBAN_PORT=8080

# Interface to publish on. 0.0.0.0 makes the board reachable from your phone and other machines;
# it then only answers requests that carry KANBAN_API_KEY.
# KANBAN_BIND=127.0.0.1

# Required by every API/MCP call when set. The board UI asks for it once.
# KANBAN_API_KEY=

# Your key for the Director role (accepting work, answering questions, project settings).
# Don't give it to agents. Unset, any client may act as the Director.
# KANBAN_DIRECTOR_KEY=

# A folder holding your repos, mounted read-only so projects can set repo_path.
# KANBAN_REPOS=/Users/you/Developer
